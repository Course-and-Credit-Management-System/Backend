JWT_SECRET_KEY=change_this_to_a_long_random_string_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# cookie settings
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_NAME=access_token


SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=db6bf55483d616
SMTP_PASS=PASTE_THE_REAL_PASSWORD_FROM_MAILTRAP
