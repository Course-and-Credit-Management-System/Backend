FRONTEND_URL= URL

# Gemini / RAG
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-2.5-pro
GEMINI_CHAT_FALLBACK_MODEL=gemini-2.5-flash
